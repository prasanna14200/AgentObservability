+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pandas as pd
+
+from agentsentinel.data.preprocess import (
+    ANOMALY_TYPE_SENTINEL,
+    LABEL_SENTINEL,
+    POLICY_VERSION_SENTINEL,
+    build_dataframe,
+    discover_trace_files,
+    run,
+)
+
+
+def _event(event_id: str, trace_id: str, **overrides: object) -> dict:
+    base = {
+        "event_id": event_id,
+        "trace_id": trace_id,
+        "agent_id": "agent-1",
+        "task_id": "task-1",
+        "timestamp": "2026-01-01T09:00:00+00:00",
+        "event_type": "tool_call",
+        "tool_name": "search_customer",
+        "tool_input_metadata": {"customer_ref_hash": "cust_hash_1"},
+        "tool_output_metadata": {"record_count": 1, "result_size_bytes": 300},
+        "latency_ms": 120,
+        "status": "success",
+        "retry_count": 0,
+        "token_usage": 100,
+        "estimated_cost_usd": 0.0002,
+        "permissions": ["orders:read"],
+        "task_type": "order_lookup",
+    }
+    base.update(overrides)
+    return base
+
+
+def _trace(trace_id: str, **overrides: object) -> dict:
+    base = {
+        "trace_id": trace_id,
+        "dataset_version": "test-v1",
+        "data_type": "synthetic",
+        "limitations": "test data",
+        "label": "normal",
+        "anomaly_type": None,
+        "agent_id": "agent-1",
+        "task_id": "task-1",
+        "task_type": "order_lookup",
+        "events": [_event(f"{trace_id}-event-00", trace_id)],
+    }
+    base.update(overrides)
+    return base
+
+
+def _write_jsonl(path: Path, rows: list[dict]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("w", encoding="utf-8") as handle:
+        for row in rows:
+            handle.write(json.dumps(row) + "\n")
+
+
+def test_missing_label_anomaly_type_and_policy_version_filled_with_sentinel(
+    tmp_path: Path,
+) -> None:
+    synthetic_dir = tmp_path / "synthetic"
+    trace = _trace("trace-real-1", data_type="real", label=None, anomaly_type=None)
+    trace["policy_version"] = None
+    _write_jsonl(synthetic_dir / "unlabeled" / "traces.jsonl", [trace])
+
+    df, _ = build_dataframe(synthetic_dir=synthetic_dir, collected_dir=tmp_path / "missing")
+
+    assert len(df) == 1
+    assert df.loc[0, "label"] == LABEL_SENTINEL
+    assert df.loc[0, "anomaly_type"] == ANOMALY_TYPE_SENTINEL
+    assert df.loc[0, "policy_version"] == POLICY_VERSION_SENTINEL
+    assert not df["label"].isna().any()
+
+
+def test_rows_are_not_dropped_for_missing_label(tmp_path: Path) -> None:
+    synthetic_dir = tmp_path / "synthetic"
+    labeled = _trace("trace-labeled", label="anomalous", anomaly_type="tool_loop")
+    unlabeled = _trace("trace-unlabeled", label=None, anomaly_type=None)
+    _write_jsonl(synthetic_dir / "mixed" / "traces.jsonl", [labeled, unlabeled])
+
+    df, stats = build_dataframe(synthetic_dir=synthetic_dir, collected_dir=tmp_path / "missing")
+
+    assert len(df) == 2
+    assert stats["row_count_after_dedup"] == 2
+
+
+def test_dedup_by_trace_and_event_id(tmp_path: Path) -> None:
+    synthetic_dir = tmp_path / "synthetic"
+    trace = _trace("trace-dup")
+    # Same trace/event written twice across two files, simulating an
+    # overlapping export or a re-run that appended the same rows again.
+    _write_jsonl(synthetic_dir / "a" / "traces.jsonl", [trace])
+    _write_jsonl(synthetic_dir / "b" / "traces.jsonl", [trace])
+
+    df, stats = build_dataframe(synthetic_dir=synthetic_dir, collected_dir=tmp_path / "missing")
+
+    assert stats["row_count_before_dedup"] == 2
+    assert stats["row_count_after_dedup"] == 1
+    assert stats["duplicate_rows_removed"] == 1
+    assert len(df) == 1
+
+
+def test_type_coercion_for_numeric_fields(tmp_path: Path) -> None:
+    synthetic_dir = tmp_path / "synthetic"
+    trace = _trace("trace-types")
+    _write_jsonl(synthetic_dir / "a" / "traces.jsonl", [trace])
+
+    df, _ = build_dataframe(synthetic_dir=synthetic_dir, collected_dir=tmp_path / "missing")
+
+    assert str(df["latency_ms"].dtype) == "Int64"
+    assert str(df["token_usage"].dtype) == "Int64"
+    assert str(df["retry_count"].dtype) == "Int64"
+    assert str(df["output_record_count"].dtype) == "Int64"
+    assert str(df["estimated_cost_usd"].dtype) == "float64"
+    assert pd.api.types.is_datetime64_any_dtype(df["event_timestamp"])
+    assert str(df["event_timestamp"].dt.tz) == "UTC"
+
+
+def test_provenance_source_column_distinguishes_synthetic_and_collected(
+    tmp_path: Path,
+) -> None:
+    synthetic_dir = tmp_path / "synthetic"
+    collected_dir = tmp_path / "collected"
+    _write_jsonl(synthetic_dir / "normal" / "traces.jsonl", [_trace("trace-syn")])
+    _write_jsonl(
+        collected_dir / "normal" / "traces.jsonl",
+        [_trace("trace-col", data_type="real")],
+    )
+
+    df, stats = build_dataframe(synthetic_dir=synthetic_dir, collected_dir=collected_dir)
+
+    assert set(df["source"]) == {"synthetic", "collected"}
+    assert stats["input_sources"]["synthetic"]["trace_count"] == 1
+    assert stats["input_sources"]["collected"]["trace_count"] == 1
+    # data_type is preserved independently of source -- the two are never
+    # derived from one another.
+    syn_row = df[df["source"] == "synthetic"].iloc[0]
+    col_row = df[df["source"] == "collected"].iloc[0]
+    assert syn_row["data_type"] == "synthetic"
+    assert col_row["data_type"] == "real"
+
+
+def test_discover_trace_files_excludes_rejection_log(tmp_path: Path) -> None:
+    root = tmp_path / "collected"
+    _write_jsonl(root / "normal" / "traces.jsonl", [_trace("trace-ok")])
+    _write_jsonl(
+        root / "rejected" / "rejections.jsonl",
+        [{"reason": "bad", "trace_id": None, "sanitized_event": {}}],
+    )
+
+    found = discover_trace_files(root)
+
+    assert len(found) == 1
+    assert "rejected" not in found[0].parts
+
+
+def test_discover_trace_files_missing_root_returns_empty_list(tmp_path: Path) -> None:
+    assert discover_trace_files(tmp_path / "does-not-exist") == []
+
+
+def test_no_feature_engineering_columns_present(tmp_path: Path) -> None:
+    """Spot-check against Phase 6 scope leaking into Phase 5 output."""
+
+    synthetic_dir = tmp_path / "synthetic"
+    _write_jsonl(synthetic_dir / "normal" / "traces.jsonl", [_trace("trace-scope")])
+
+    df, _ = build_dataframe(synthetic_dir=synthetic_dir, collected_dir=tmp_path / "missing")
+
+    forbidden_substrings = ("_rate", "_ratio", "_zscore", "rolling_", "baseline_", "per_minute")
+    for column in df.columns:
+        for forbidden in forbidden_substrings:
+            assert forbidden not in column, f"{column!r} looks like a Phase 6 feature"
+
+
+def test_run_writes_versioned_parquet_and_manifest(tmp_path: Path) -> None:
+    synthetic_dir = tmp_path / "synthetic"
+    _write_jsonl(synthetic_dir / "normal" / "traces.jsonl", [_trace("trace-e2e")])
+    output_root = tmp_path / "processed"
+
+    manifest = run(
+        synthetic_dir=synthetic_dir,
+        collected_dir=tmp_path / "missing",
+        output_root=output_root,
+        version="v1",
+    )
+
+    parquet_path = Path(manifest["_parquet_path"])
+    manifest_path = Path(manifest["_manifest_path"])
+    assert parquet_path.exists()
+    assert manifest_path.exists()
+    assert parquet_path.parent == output_root / "v1"
+
+    round_tripped = pd.read_parquet(parquet_path)
+    assert len(round_tripped) == manifest["row_count_after_dedup"]
+
+    manifest_on_disk = json.loads(manifest_path.read_text(encoding="utf-8"))
+    assert manifest_on_disk["version"] == "v1"
+    assert "generated_at" in manifest_on_disk
+    assert manifest_on_disk["schema_version"] == "phase5-preprocess-v1"
