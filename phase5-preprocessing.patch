+++ b/src/agentsentinel/data/preprocess.py
@@ -0,0 +1,380 @@
+"""Phase 5 preprocessing: raw validated Trace JSONL -> analysis-ready table.
+
+This module loads Phase 2 synthetic traces (`data/synthetic/`) and Phase 4
+collected traces (`data/collected/`), flattens each trace's nested events
+into one row per event, and writes a versioned Parquet dataset plus a
+manifest under `data/processed/<version>/`.
+
+Explicitly out of scope (see docs/design_decisions.md):
+
+- No derived/behavioral features (rates, ratios, rolling windows, baselines).
+  That is Phase 6. If a column here looks like "calls per minute" or a
+  z-score, it does not belong in this module.
+- No EDA plots or notebook output. That is Phase 7.
+- No changes to the Phase 3 schema or Phase 4 collector logic.
+
+Row granularity: one row per tool-call *event*, not one row per trace. Trace-
+level fields (trace_id, label, anomaly_type, data_type, agent_id, task_id,
+task_type, dataset_version, limitations, policy_version) are repeated onto
+every event row belonging to that trace. This matches how Phase 6/7 will
+consume the data: per-event operational fields (latency_ms, token_usage,
+retry_count, status) are what feature engineering and EDA need directly, and
+a nested list-of-events column would just force every downstream consumer to
+re-flatten it themselves.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+import pandas as pd
+
+SCHEMA_VERSION = "phase5-preprocess-v1"
+
+# Directories/files that exist under data/collected/ but are NOT valid Trace
+# records and must never be loaded as trace data: the rejection log written
+# by TraceCollector._reject() for malformed input (see Phase 4 patch note in
+# docs/phase4_completion.md for why that log itself must stay sanitized).
+_EXCLUDED_PATH_SEGMENTS = {"rejected"}
+
+# Sentinel values for fields that are legitimately absent on real/unlabeled
+# traces (see TraceAuditMetadata in schema/trace.py: label, anomaly_type, and
+# policy_version are all nullable). We fill with explicit sentinels rather
+# than leaving NaN/None so that:
+#   (a) rows are never dropped for missing labels -- an unlabeled real trace
+#       is still a valid row for Phase 6/7, just not a supervised-learning
+#       label:
+#   (b) downstream groupby/value_counts/one-hot operations in Phase 6/7 see
+#       one consistent string dtype per column instead of a silent mix of
+#       str and float('nan').
+LABEL_SENTINEL = "unlabeled"
+ANOMALY_TYPE_SENTINEL = "none"
+POLICY_VERSION_SENTINEL = "unassigned"
+
+# Nullable pandas integer dtype: preserves NaN-safe integer semantics for
+# counts, since numpy int64 has no way to represent a missing value.
+_NULLABLE_INT_COLUMNS = (
+    "retry_count",
+    "latency_ms",
+    "token_usage",
+    "output_record_count",
+    "output_result_size_bytes",
+)
+_FLOAT_COLUMNS = ("estimated_cost_usd",)
+
+DEDUP_SUBSET = ("trace_id", "event_id")
+
+
+def discover_trace_files(root: Path) -> list[Path]:
+    """Return every traces.jsonl under root, excluding rejection logs.
+
+    Returns an empty list if root does not exist (e.g. data/collected/ has
+    never been written to on a fresh checkout, since it is gitignored).
+    """
+
+    if not root.exists():
+        return []
+
+    return sorted(
+        path
+        for path in root.rglob("traces.jsonl")
+        if not _EXCLUDED_PATH_SEGMENTS.intersection(path.parts)
+    )
+
+
+def load_raw_traces(paths: list[Path]) -> list[dict[str, Any]]:
+    """Load and JSON-parse every line of every given JSONL file."""
+
+    records: list[dict[str, Any]] = []
+    for path in paths:
+        with path.open("r", encoding="utf-8") as handle:
+            for line in handle:
+                line = line.strip()
+                if not line:
+                    continue
+                records.append(json.loads(line))
+    return records
+
+
+def flatten_trace(trace: dict[str, Any], source: str) -> list[dict[str, Any]]:
+    """Flatten one Phase2-shaped trace record into one row per event.
+
+    `source` records which pipeline produced this trace file (`"synthetic"`
+    from data/synthetic/, `"collected"` from data/collected/) -- this is
+    provenance about *how the record was loaded*, distinct from the trace's
+    own `data_type` field (`"synthetic"`/`"real"`), which is preserved
+    unchanged as its own column. The two can legitimately disagree (e.g. a
+    real production trace captured by the Phase 4 collector still has
+    `source="collected"`, `data_type="real"`), and that disagreement is
+    itself useful signal, so neither is derived from the other.
+    """
+
+    trace_fields = {
+        "source": source,
+        "trace_id": trace.get("trace_id"),
+        "dataset_version": trace.get("dataset_version"),
+        "data_type": trace.get("data_type"),
+        "limitations": trace.get("limitations"),
+        "label": trace.get("label"),
+        "anomaly_type": trace.get("anomaly_type"),
+        "policy_version": trace.get("policy_version"),
+        "agent_id": trace.get("agent_id"),
+        "task_id": trace.get("task_id"),
+        "task_type": trace.get("task_type"),
+    }
+
+    rows: list[dict[str, Any]] = []
+    for event in trace.get("events", []):
+        output_meta = event.get("tool_output_metadata") or {}
+        row = dict(trace_fields)
+        row.update(
+            {
+                "event_id": event.get("event_id"),
+                "event_timestamp_raw": event.get("timestamp"),
+                "event_type": event.get("event_type"),
+                "tool_name": event.get("tool_name"),
+                "status": event.get("status"),
+                "retry_count": event.get("retry_count"),
+                "latency_ms": event.get("latency_ms"),
+                "token_usage": event.get("token_usage"),
+                "estimated_cost_usd": event.get("estimated_cost_usd"),
+                "output_record_count": output_meta.get("record_count"),
+                "output_result_size_bytes": output_meta.get("result_size_bytes"),
+                "permissions": event.get("permissions"),
+                # Tool arguments are kept as a JSON string, not expanded into
+                # per-key columns: argument shape varies by tool_name
+                # (search_customer/get_order/update_order each have
+                # different keys), so a fixed set of flat columns cannot
+                # represent them without inventing per-tool schemas -- that
+                # design decision belongs to Phase 6 feature engineering,
+                # not Phase 5 preprocessing. Values are already redacted at
+                # schema/collector level (see schema/redaction.py); this is
+                # a pass-through, not a re-redaction.
+                "tool_input_metadata_json": json.dumps(
+                    event.get("tool_input_metadata"), sort_keys=True
+                ),
+            }
+        )
+        rows.append(row)
+    return rows
+
+
+def load_source(root: Path, source: str) -> tuple[list[dict[str, Any]], int]:
+    """Load and flatten all traces under root; return (rows, trace_count)."""
+
+    paths = discover_trace_files(root)
+    traces = load_raw_traces(paths)
+    rows: list[dict[str, Any]] = []
+    for trace in traces:
+        rows.extend(flatten_trace(trace, source=source))
+    return rows, len(traces)
+
+
+def _apply_null_handling(df: pd.DataFrame) -> pd.DataFrame:
+    df = df.copy()
+    df["label"] = df["label"].fillna(LABEL_SENTINEL)
+    df["anomaly_type"] = df["anomaly_type"].fillna(ANOMALY_TYPE_SENTINEL)
+    df["policy_version"] = df["policy_version"].fillna(POLICY_VERSION_SENTINEL)
+    return df
+
+
+def _parse_timestamps(df: pd.DataFrame) -> pd.DataFrame:
+    df = df.copy()
+    df["event_timestamp"] = pd.to_datetime(
+        df["event_timestamp_raw"], utc=True, errors="raise"
+    )
+    df = df.drop(columns=["event_timestamp_raw"])
+    return df
+
+
+def _coerce_types(df: pd.DataFrame) -> pd.DataFrame:
+    df = df.copy()
+    for column in _NULLABLE_INT_COLUMNS:
+        df[column] = pd.array(df[column], dtype="Int64")
+    for column in _FLOAT_COLUMNS:
+        df[column] = df[column].astype("float64")
+    return df
+
+
+def _deduplicate(df: pd.DataFrame) -> tuple[pd.DataFrame, int]:
+    before = len(df)
+    df = df.drop_duplicates(subset=list(DEDUP_SUBSET), keep="first").reset_index(
+        drop=True
+    )
+    removed = before - len(df)
+    return df, removed
+
+
+def build_dataframe(
+    synthetic_dir: Path = Path("data/synthetic"),
+    collected_dir: Path = Path("data/collected"),
+) -> tuple[pd.DataFrame, dict[str, Any]]:
+    """Load, clean, and flatten synthetic + collected traces into one table.
+
+    Returns (dataframe, stats) where `stats` records everything the
+    manifest needs: input sources, row counts before/after dedup, and the
+    null-handling sentinels applied.
+    """
+
+    synthetic_rows, synthetic_trace_count = load_source(synthetic_dir, "synthetic")
+    collected_rows, collected_trace_count = load_source(collected_dir, "collected")
+    all_rows = synthetic_rows + collected_rows
+
+    columns = [
+        "source",
+        "trace_id",
+        "dataset_version",
+        "data_type",
+        "limitations",
+        "label",
+        "anomaly_type",
+        "policy_version",
+        "agent_id",
+        "task_id",
+        "task_type",
+        "event_id",
+        "event_timestamp_raw",
+        "event_type",
+        "tool_name",
+        "status",
+        "retry_count",
+        "latency_ms",
+        "token_usage",
+        "estimated_cost_usd",
+        "output_record_count",
+        "output_result_size_bytes",
+        "permissions",
+        "tool_input_metadata_json",
+    ]
+    df = pd.DataFrame(all_rows, columns=columns)
+
+    rows_before_dedup = len(df)
+    df = _apply_null_handling(df)
+    if not df.empty:
+        df = _parse_timestamps(df)
+    else:
+        df["event_timestamp"] = pd.Series(dtype="datetime64[ns, UTC]")
+        df = df.drop(columns=["event_timestamp_raw"])
+    df = _coerce_types(df)
+    df, duplicates_removed = _deduplicate(df)
+
+    stats = {
+        "input_sources": {
+            "synthetic": {
+                "root": str(synthetic_dir),
+                "trace_count": synthetic_trace_count,
+                "event_row_count": len(synthetic_rows),
+            },
+            "collected": {
+                "root": str(collected_dir),
+                "trace_count": collected_trace_count,
+                "event_row_count": len(collected_rows),
+            },
+        },
+        "row_count_before_dedup": rows_before_dedup,
+        "row_count_after_dedup": len(df),
+        "duplicate_rows_removed": duplicates_removed,
+        "dedup_subset": list(DEDUP_SUBSET),
+        "null_handling": {
+            "label": {
+                "sentinel": LABEL_SENTINEL,
+                "reason": "null on real/unlabeled traces; rows are kept, not dropped",
+            },
+            "anomaly_type": {
+                "sentinel": ANOMALY_TYPE_SENTINEL,
+                "reason": "null on normal or unlabeled traces; rows are kept, not dropped",
+            },
+            "policy_version": {
+                "sentinel": POLICY_VERSION_SENTINEL,
+                "reason": "policy engine (later phase) has not populated this yet",
+            },
+        },
+        "schema_version": SCHEMA_VERSION,
+    }
+    return df, stats
+
+
+def write_processed(
+    df: pd.DataFrame,
+    stats: dict[str, Any],
+    output_root: Path,
+    version: str,
+) -> tuple[Path, Path]:
+    """Write the versioned Parquet dataset and manifest.json.
+
+    Parquet was chosen over CSV: this dataset is read repeatedly by Phase 6
+    (feature engineering) and Phase 7 (EDA), and Parquet preserves exact
+    dtypes (nullable Int64, UTC-aware datetime64, float64) round-trip. CSV
+    would silently degrade every one of those on load unless every consumer
+    re-declares dtypes by hand -- a class of bug that surfaces only once a
+    later phase feeds a string into a numeric feature. The tradeoff is one
+    added dependency, `pyarrow`, declared in pyproject.toml.
+    """
+
+    output_dir = output_root / version
+    output_dir.mkdir(parents=True, exist_ok=True)
+
+    parquet_path = output_dir / "traces.parquet"
+    df.to_parquet(parquet_path, index=False)
+
+    manifest = {
+        "version": version,
+        "generated_at": datetime.now(timezone.utc).replace(microsecond=0).isoformat(),
+        **stats,
+    }
+    manifest_path = output_dir / "manifest.json"
+    manifest_path.write_text(
+        json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+
+    return parquet_path, manifest_path
+
+
+def run(
+    synthetic_dir: Path = Path("data/synthetic"),
+    collected_dir: Path = Path("data/collected"),
+    output_root: Path = Path("data/processed"),
+    version: str = "v1",
+) -> dict[str, Any]:
+    """End-to-end Phase 5 entry point: load -> clean -> write. Returns manifest dict."""
+
+    df, stats = build_dataframe(synthetic_dir=synthetic_dir, collected_dir=collected_dir)
+    parquet_path, manifest_path = write_processed(
+        df, stats, output_root=output_root, version=version
+    )
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    manifest["_parquet_path"] = str(parquet_path)
+    manifest["_manifest_path"] = str(manifest_path)
+    return manifest
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--synthetic-dir", type=Path, default=Path("data/synthetic"))
+    parser.add_argument("--collected-dir", type=Path, default=Path("data/collected"))
+    parser.add_argument("--output-root", type=Path, default=Path("data/processed"))
+    parser.add_argument("--version", type=str, default="v1")
+    return parser.parse_args()
+
+
+def main() -> None:
+    args = parse_args()
+    manifest = run(
+        synthetic_dir=args.synthetic_dir,
+        collected_dir=args.collected_dir,
+        output_root=args.output_root,
+        version=args.version,
+    )
+    print(
+        f"Wrote {manifest['row_count_after_dedup']} rows "
+        f"({manifest['duplicate_rows_removed']} duplicates removed) to "
+        f"{manifest['_parquet_path']}"
+    )
+
+
+if __name__ == "__main__":
+    main()
