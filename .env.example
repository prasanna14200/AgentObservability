# Local PayPal Sandbox configuration.
# Copy to the ignored .env file and replace placeholders there.
# Never commit credentials or paste them into chat.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET
PAYPAL_MERCHANT_ID=YOUR_SANDBOX_MERCHANT_ID

# Day 9 local model selection; Ollama stays on 127.0.0.1. No API key is used.
OLLAMA_MODEL=YOUR_LOCAL_MODEL_NAME
